# ---------------------------------------------------------------------------
# Volunteerhub environment variables
# ---------------------------------------------------------------------------
# Backend (Cloudflare Worker). Locally, put these in backend/.dev.vars.
# In production set non-secret values in infra/cloudflare/wrangler.toml [vars]
# and secrets with `wrangler secret put NAME` (or as GitHub Actions secrets).

ENVIRONMENT=development                 # "production" forces Secure cookies
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173   # extra origins allowed to send POST/PATCH (dev UI)
VISITOR_SALT=change-me-to-a-random-string   # secret: anonymises IPs for unique views
ADMIN_EMAILS=you@example.com            # secret: these e-mails become admins on registration
# MONO_TOKEN_KEY=                        # secret: base64 of 32 random bytes, encrypts organizers' Monobank tokens (openssl rand -base64 32). Required in production for live jar totals.
GOOGLE_CLIENT_ID=994822121085-m28q8e8mlvb1vudambms6ejlr3934l5o.apps.googleusercontent.com
# PLATFORM_SUPPORT_JAR_URL=https://send.monobank.ua/jar/XXXXXXXXXX   # separate jar supporting the platform

# Frontend (Next.js dev server only)
API_URL=http://localhost:8787           # where `next dev` proxies /api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=994822121085-m28q8e8mlvb1vudambms6ejlr3934l5o.apps.googleusercontent.com

# Deployment (GitHub Actions secrets / your shell)
CLOUDFLARE_API_TOKEN=                   # token with Workers Scripts:Edit + D1:Edit
CLOUDFLARE_ACCOUNT_ID=
