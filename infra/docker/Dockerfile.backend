# Local development image for the API (Cloudflare Workers runtime via wrangler/workerd, local SQLite D1).
FROM node:22-bookworm-slim
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY backend/ ./
EXPOSE 8787
# Applies migrations, seeds demo data on first start, then runs the API on 0.0.0.0:8787.
CMD ["sh", "-c", "npx wrangler d1 migrations apply DB --local && (test -f .wrangler/.seeded || (npx tsx seed/build-seed.ts > seed/demo.sql && npx wrangler d1 execute DB --local --file seed/demo.sql && touch .wrangler/.seeded)) && npx wrangler dev --ip 0.0.0.0 --port 8787"]
