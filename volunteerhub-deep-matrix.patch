+    border: 1px solid rgb(180 255 0 / 28%);
+    background: rgb(180 255 0 / 7%);
+    box-shadow: 0 0 24px rgb(180 255 0 / 7%);
+  }
+}
+
+/* The page itself enters with a restrained directional wipe on route changes. */
+main > * {
+  animation: route-enter 520ms cubic-bezier(.2,.75,.25,1) both;
+}
+@keyframes route-enter {
+  from { opacity: .72; transform: translateY(10px); clip-path: inset(1.5% 0 0); }
+  to { opacity: 1; transform: translateY(0); clip-path: inset(0 0 0); }
+}
+@media (prefers-reduced-motion: reduce) {
